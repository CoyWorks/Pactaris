{
  "name": "@pactaris/instance-foundation",
  "version": "0.13.0-alpha.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "catalogs": "node scripts/build-catalogs.mjs",
    "prebuild": "npm run catalogs",
    "pretypecheck": "npm run catalogs",
    "pretest": "npm run catalogs",
    "precheck:i18n": "npm run catalogs",
    "predev:instance": "npm run catalogs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:i18n": "node --import tsx scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run check:i18n && npm test && python3 -m unittest discover -s tests -p '*_test.py'",
    "start:instance": "node dist/server/apps/instance/server.js",
    "start:worker": "node dist/server/apps/instance/worker.js",
    "dev:instance": "node --import tsx apps/instance/server.ts",
    "start:gateway": "node dist/server/apps/gateway/server.js",
    "start:gateway-worker": "node dist/server/apps/gateway/worker.js",
    "migrate": "node dist/server/scripts/migrate.js",
    "test:integration": "node --import tsx --test tests/*.integration.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "intl-messageformat": "10.7.18",
    "jose": "6.2.17",
    "nodemailer": "10.6.0",
    "openid-client": "6.9.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "light-my-request": "6.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
