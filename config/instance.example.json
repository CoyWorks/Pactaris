{
  "instanceId": "00000000-0000-4000-8000-000000000001",
  "publicOrigin": "https://instance.example.invalid",
  "listen": { "address": "127.0.0.1", "port": 9444, "tls": { "certFile": "/etc/the-app/instance/tls.crt", "keyFile": "/etc/the-app/instance/tls.key", "caFile": "/etc/the-app/instance/ca.crt", "serverName": "instance.example.invalid" } },
